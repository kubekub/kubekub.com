---
import Hero from '~/components/widgets/Hero.astro';
import Layout from '~/layouts/PageLayout.astro';
import PlatformArchitecture from '~/components/blueprint/PlatformArchitecture';
import { readFileSync } from 'fs';
import yaml from 'js-yaml';
import { fileURLToPath } from 'url';
import path from 'path';

const metadata = {
  title: 'Platform Blueprint: Reference Architecture',
  description: 'Battle-tested Kubernetes reference architecture for secure Agentic AI workloads. A technology blueprint refined through years of expertise to help our customers build production-ready platforms.',
};

// Load platform technologies data
const __dirname = path.dirname(fileURLToPath(import.meta.url));
const yamlPath = path.join(__dirname, '../data/blueprint/platform-technologies.yaml');
const platformData = yaml.load(readFileSync(yamlPath, 'utf8'));
---

<Layout metadata={metadata}>

  <!-- Hero Widget ******************* -->

  <Hero
    tagline="Technology Blueprint"
    title="Reference Architecture for Agentic AI"
    subtitle="Our curated technology stack refined through years of expertise. This is not a SaaS platform—it's a proven blueprint to help customers build secure, production-ready Agentic AI platforms on Kubernetes."
  >
  </Hero>

  <!-- Interactive Architecture Diagram ******************* -->
  
  <section class="px-4 py-16 sm:px-6 mx-auto lg:px-8 lg:py-20 max-w-7xl">
    <div class="mb-8 text-center">
      <h2 class="text-4xl md:text-5xl font-bold leading-tighter tracking-tighter mb-4 font-heading">
        Platform Blueprint
      </h2>
      <p class="text-xl text-muted dark:text-slate-400">
        Multi-cloud Kubernetes architecture with carefully selected technologies
      </p>
    </div>
    
    <PlatformArchitecture platformData={platformData} client:load />
  </section>

  <!-- Architecture Layers Table *** -->

  <section class="px-4 py-16 sm:px-6 mx-auto lg:px-8 lg:py-20 max-w-7xl">
    <div class="mb-12">
      <h2 class="text-4xl md:text-5xl font-bold leading-tighter tracking-tighter mb-4 font-heading">
        Architecture Layers
      </h2>
      <p class="text-xl text-muted dark:text-slate-400 mb-8">
        Four-layer architecture for enterprise-grade agentic AI
      </p>

      <div class="overflow-x-auto border border-slate-200 dark:border-slate-800 rounded-lg">
        <table class="w-full text-sm">
          <thead class="bg-slate-100 dark:bg-slate-900 border-b border-slate-200 dark:border-slate-800">
            <tr>
              <th class="px-6 py-4 text-left font-bold text-slate-900 dark:text-slate-200">Layer</th>
              <th class="px-6 py-4 text-left font-bold text-slate-900 dark:text-slate-200">Purpose</th>
              <th class="px-6 py-4 text-left font-bold text-slate-900 dark:text-slate-200">Key Technologies</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200 dark:divide-slate-800">
            <tr class="hover:bg-slate-50 dark:hover:bg-slate-900/30 transition">
              <td class="px-6 py-4">
                <div class="flex items-center gap-3">
                  <div class="w-3 h-3 rounded-full bg-rose-400"></div>
                  <span class="font-bold text-slate-900 dark:text-slate-200">Kubekub Agentic</span>
                </div>
              </td>
              <td class="px-6 py-4 text-slate-700 dark:text-slate-400">
                Autonomous agent orchestration layer with agent protocol handling and LLM traffic management
              </td>
              <td class="px-6 py-4 text-slate-700 dark:text-slate-400">
                KAgent, Agent Gateway, Envoy AI Gateway, ToolHive, kMCP
              </td>
            </tr>
            <tr class="hover:bg-slate-50 dark:hover:bg-slate-900/30 transition">
              <td class="px-6 py-4">
                <div class="flex items-center gap-3">
                  <div class="w-3 h-3 rounded-full bg-amber-400"></div>
                  <span class="font-bold text-slate-900 dark:text-slate-200">Kubekub Identity</span>
                </div>
              </td>
              <td class="px-6 py-4 text-slate-700 dark:text-slate-400">
                Authentication and fine-grained authorization with centralized identity management
              </td>
              <td class="px-6 py-4 text-slate-700 dark:text-slate-400">
                OAuth2 (Keycloak), Policy-based Authorization
              </td>
            </tr>
            <tr class="hover:bg-slate-50 dark:hover:bg-slate-900/30 transition">
              <td class="px-6 py-4">
                <div class="flex items-center gap-3">
                  <div class="w-3 h-3 rounded-full bg-emerald-400"></div>
                  <span class="font-bold text-slate-900 dark:text-slate-200">Kubekub Ops</span>
                </div>
              </td>
              <td class="px-6 py-4 text-slate-700 dark:text-slate-400">
                GitOps, networking, security, observability, and disaster recovery
              </td>
              <td class="px-6 py-4 text-slate-700 dark:text-slate-400">
                <div class="space-y-1">
                  <div><strong>GitOps:</strong> ArgoCD, Crossplane</div>
                  <div><strong>Security:</strong> Kyverno, Falco, Calico, Istio, Cert Manager, Ext. Secrets</div>
                  <div><strong>Observability:</strong> Prometheus, Grafana Mimir, Loki, Tempo, OpenTelemetry, Kiali, Alertmanager</div>
                  <div><strong>DR:</strong> Velero</div>
                </div>
              </td>
            </tr>
            <tr class="hover:bg-slate-50 dark:hover:bg-slate-900/30 transition">
              <td class="px-6 py-4">
                <div class="flex items-center gap-3">
                  <div class="w-3 h-3 rounded-full bg-blue-400"></div>
                  <span class="font-bold text-slate-900 dark:text-slate-200">Infrastructure & Core</span>
                </div>
              </td>
              <td class="px-6 py-4 text-slate-700 dark:text-slate-400">
                Kubernetes unified API abstraction across any cloud or on-premises
              </td>
              <td class="px-6 py-4 text-slate-700 dark:text-slate-400">
                AWS EKS, Azure AKS, GCP GKE, Tencent TKE, Bare Metal (Kubespray, Minikube)
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

</Layout>

