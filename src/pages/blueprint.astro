---
import Hero from '~/components/widgets/Hero.astro';
import Layout from '~/layouts/PageLayout.astro';
import PlatformArchitecture from '~/components/blueprint/PlatformArchitecture';
import { readFileSync } from 'fs';
import yaml from 'js-yaml';
import { fileURLToPath } from 'url';
import path from 'path';

const metadata = {
  title: 'Platform Blueprint: Reference Architecture',
  description: 'Battle-tested Kubernetes reference architecture for secure Agentic AI workloads. A technology blueprint refined through years of expertise to help our customers build production-ready platforms.',
};

// Load platform technologies data
const __dirname = path.dirname(fileURLToPath(import.meta.url));
const yamlPath = path.join(__dirname, '../data/blueprint/platform-technologies.yaml');
const platformData = yaml.load(readFileSync(yamlPath, 'utf8'));
---

<Layout metadata={metadata}>

  <!-- Hero Widget ******************* -->

  <Hero
    tagline="Technology Blueprint"
    title="Reference Architecture for Agentic AI"
    subtitle="Our curated technology stack refined through years of expertise. This is not a SaaS platform—it's a proven blueprint to help customers build secure, production-ready Agentic AI platforms on Kubernetes."
  >
  </Hero>

  <!-- Interactive Architecture Diagram ******************* -->
  
  <section class="px-4 py-16 sm:px-6 mx-auto lg:px-8 lg:py-20 max-w-7xl">
    <div class="mb-8 text-center">
      <h2 class="text-4xl md:text-5xl font-bold leading-tighter tracking-tighter mb-4 font-heading">
        Platform Blueprint
      </h2>
      <p class="text-xl text-muted dark:text-slate-400">
        Multi-cloud Kubernetes architecture with carefully selected technologies
      </p>
    </div>
    
    <PlatformArchitecture platformData={platformData} client:load />
  </section>

  <!-- Architecture Layers Cards *** -->

  <section class="px-4 py-16 sm:px-6 mx-auto lg:px-8 lg:py-20 max-w-7xl">
    <div class="mb-12">
      <h2 class="text-4xl md:text-5xl font-bold leading-tighter tracking-tighter mb-4 font-heading">
        Architecture Layers
      </h2>
      <p class="text-xl text-muted dark:text-slate-400 mb-8">
        Four-layer architecture for enterprise-grade agentic AI
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <!-- Agentic Layer -->
        <div class="border-l-4 border-rose-400 bg-slate-50 dark:bg-slate-900/30 rounded-lg p-6 hover:shadow-lg transition">
          <div class="flex items-center gap-3 mb-3">
            <div class="w-3 h-3 rounded-full bg-rose-400"></div>
            <h3 class="font-bold text-lg text-slate-900 dark:text-slate-200">Kubekub Agentic</h3>
          </div>
          <p class="text-sm text-slate-700 dark:text-slate-400">
            Autonomous agent orchestration layer with agent protocol handling and LLM traffic management
          </p>
        </div>

        <!-- Identity Layer -->
        <div class="border-l-4 border-amber-400 bg-slate-50 dark:bg-slate-900/30 rounded-lg p-6 hover:shadow-lg transition">
          <div class="flex items-center gap-3 mb-3">
            <div class="w-3 h-3 rounded-full bg-amber-400"></div>
            <h3 class="font-bold text-lg text-slate-900 dark:text-slate-200">Kubekub Identity</h3>
          </div>
          <p class="text-sm text-slate-700 dark:text-slate-400">
            Authentication and fine-grained authorization with centralized identity management
          </p>
        </div>

        <!-- Ops Layer -->
        <div class="border-l-4 border-emerald-400 bg-slate-50 dark:bg-slate-900/30 rounded-lg p-6 hover:shadow-lg transition">
          <div class="flex items-center gap-3 mb-3">
            <div class="w-3 h-3 rounded-full bg-emerald-400"></div>
            <h3 class="font-bold text-lg text-slate-900 dark:text-slate-200">Kubekub Ops</h3>
          </div>
          <p class="text-sm text-slate-700 dark:text-slate-400">
            GitOps, networking, security, observability, and disaster recovery
          </p>
        </div>

        <!-- Infrastructure Layer -->
        <div class="border-l-4 border-blue-400 bg-slate-50 dark:bg-slate-900/30 rounded-lg p-6 hover:shadow-lg transition">
          <div class="flex items-center gap-3 mb-3">
            <div class="w-3 h-3 rounded-full bg-blue-400"></div>
            <h3 class="font-bold text-lg text-slate-900 dark:text-slate-200">Infrastructure & Core</h3>
          </div>
          <p class="text-sm text-slate-700 dark:text-slate-400">
            Kubernetes unified API abstraction across any cloud or on-premises
          </p>
          </div>
        </div>
      </div>
    </div>
  </section>

</Layout>

