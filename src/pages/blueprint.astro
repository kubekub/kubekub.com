---
import Hero from '~/components/widgets/Hero.astro';
import Content from '~/components/widgets/Content.astro';
import Layout from '~/layouts/PageLayout.astro';
import PlatformArchitecture from '~/components/blueprint/PlatformArchitecture';
import { readFileSync } from 'fs';
import yaml from 'js-yaml';
import { fileURLToPath } from 'url';
import path from 'path';

const metadata = {
  title: 'Platform Blueprint: Reference Architecture',
  description: 'Battle-tested Kubernetes reference architecture for secure Agentic AI workloads. A technology blueprint refined through years of expertise to help our customers build production-ready platforms.',
};

// Load platform technologies data
const __dirname = path.dirname(fileURLToPath(import.meta.url));
const yamlPath = path.join(__dirname, '../data/blueprint/platform-technologies.yaml');
const platformData = yaml.load(readFileSync(yamlPath, 'utf8'));
---

<Layout metadata={metadata}>

  <!-- Hero Widget ******************* -->

  <Hero
    tagline="Technology Blueprint"
    title="Reference Architecture for Agentic AI"
    subtitle="Our curated technology stack refined through years of expertise. This is not a SaaS platform—it's a proven blueprint to help customers build secure, production-ready Agentic AI platforms on Kubernetes."
  >
  </Hero>

  <!-- Interactive Architecture Diagram ******************* -->
  
  <section class="px-4 py-16 sm:px-6 mx-auto lg:px-8 lg:py-20 max-w-7xl">
    <div class="mb-8 text-center">
      <h2 class="text-4xl md:text-5xl font-bold leading-tighter tracking-tighter mb-4 font-heading">
        Platform Blueprint
      </h2>
      <p class="text-xl text-muted dark:text-slate-400">
        Multi-cloud Kubernetes architecture with carefully selected technologies
      </p>
    </div>
    
    <PlatformArchitecture platformData={platformData} client:load />
  </section>

  <!-- Platform Architecture Overview ******************* -->

  <Content
    title="Architecture Layers"
    subtitle="Four-layer architecture for enterprise-grade agentic AI"
    isReversed
    items={[
      {
        title: 'KubeKub Agentic',
        description: 'Autonomous agent orchestration layer with KAgent, Agent Gateway, and Envoy AI Gateway for LLM traffic management and agent protocol handling.',
        icon: 'tabler:bolt',
      },
      {
        title: 'KubeKub Identity',
        description: 'Authentication and authorization layer with OAuth2 standard implemented via Keycloak for identity management, and policy-based authorization for fine-grained access control across all agents and services.',
        icon: 'tabler:shield-check',
      },
      {
        title: 'KubeKub Ops',
        description: 'GitOps layer with ArgoCD for continuous deployment and Crossplane for infrastructure as code. Includes Networking & Security (Kyverno, Calico eBPF, Istio Ambient Mesh, Cert Manager, External DNS, External Secrets) and Observability Stack (Prometheus, Grafana Mimir, Loki, Tempo, OpenTelemetry).',
        icon: 'tabler:stack',
      },
      {
        title: 'Infrastructure & Core',
        description: 'Kubernetes unified API abstraction layer running on multi-cloud (AWS EKS, Azure AKS, GCP GKE, Tencent TKE) and bare metal (Kubespray, Minikube).',
        icon: 'tabler:server',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

</Layout>

