---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Kubekub — Agentic AI Infrastructure & Platform Engineering',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'Schedule a Consultation',
        href: '/contact',
        icon: 'tabler:message-circle',
      },
      { text: 'Learn More', href: '#about' },
    ]}
  >
    <Fragment slot="title">
      Secure <span class="text-accent dark:text-white highlight">Agentic AI</span> Infrastructure on Kubernetes
    </Fragment>

    <Fragment slot="subtitle">
      <span class="font-semibold">Autonomous agents at scale:</span> build secure, governed agentic systems with <span class="font-semibold">GitOps-driven infrastructure, zero-trust security, and policy-based authorization</span> that remain portable across cloud providers and on-premises without vendor lock-in.
    </Fragment>
  </Hero>

  <!-- Note Widget ******************* -->


  <!-- Features Widget *************** -->

  <Features
    id="about"
    tagline="Expertise"
    title="Agentic AI Infrastructure on Kubernetes"
    subtitle="Design secure, autonomous agent systems with GitOps-driven platform engineering and enterprise-grade security by default"
    items={[
      {
        title: 'AI Agent Orchestration & Control',
        description:
          'KAgent, Model Context Protocol (MCP), and ToolHive for Kubernetes-native control plane, governance, and authorization of intelligent autonomous agents.',
        icon: 'tabler:robot',
      },
      {
        title: 'Agent Gateway & Request Routing',
        description:
          'Gateway API with Inference Extensions for intelligent agent request routing, load distribution, and service orchestration across agentic endpoints.',
        icon: 'tabler:route',
      },
      {
        title: 'Zero-Trust Security & Policies',
        description:
          'Istio ambient mesh, Kyverno policies, Falco runtime security, and policy-based authorization for agentic workload protection and compliance.',
        icon: 'tabler:lock',
      },
      {
        title: 'GitOps & Infrastructure Automation',
        description:
          'ArgoCD for continuous deployment, Crossplane for multi-cloud infrastructure provisioning, and GitOps-driven platform management as single source of truth.',
        icon: 'tabler:git-merge',
      },
      {
        title: 'Observable & Secure Operations',
        description:
          'Prometheus, Grafana, Loki, and OpenTelemetry for end-to-end agentic workload observability, Alertmanager for incident routing, and Velero for disaster recovery.',
        icon: 'tabler:chart-dots',
      },
      {
        title: 'Internal Developer Platform',
        description:
          'Self-service AI agent deployment platform with standardized workflows, automated security controls, and operator-managed infrastructure abstractions.',
        icon: 'tabler:hexagon-3d',
      },
      {
        title: 'Multi-Tenancy & Isolation',
        description:
          'Network policies, RBAC, resource quotas, and namespace isolation enabling multiple teams and agents to coexist securely on shared infrastructure.',
        icon: 'tabler:shield-check',
      },
    ]}
  />

  <!-- Content Widget **************** -->

  <Content
    isReversed
    tagline="The Challenge"
    title="Secure Autonomous Agents at Scale"
    items={[
      {
        title: 'Agent Governance & Authorization',
        description:
          'Move beyond ad-hoc agent deployments to governed autonomous systems with role-based access control, tool authorization, and auditable execution traces.',
      },
      {
        title: 'Zero-Trust by Default',
        description:
          'Implement ambient mesh networks, policy-driven security gates, runtime threat detection, and encryption for all agent-to-service communication.',
      },
      {
        title: 'GitOps-Driven Infrastructure',
        description:
          'Everything in Git—agent definitions, network policies, security rules, and infrastructure code. Single source of truth with continuous drift detection and remediation.',
      },
      {
        title: 'Multi-Cloud & Portable',
        description:
          'Build on open standards (Kubernetes, Gateway API, KServe) ensuring agents portable across AWS, Azure, GCP, on-premises, or hybrid deployments without refactoring.',
      },
    ]}

  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        Building Agentic Infrastructure, Not Just Deployments
      </h3>
      The difference between experimental agents and production agentic AI systems is intentional architecture combined with security-first design. I design the infrastructure layer that enables Kubernetes to serve as the secure control plane for your autonomous agent ecosystem.
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Steps Widget ****************** -->

  <Steps
    title="Agentic Infrastructure Implementation"
    items={[
      {
        title: '<span class="font-medium">Assess & Plan</span>',
        description:
          'Deep-dive into requirements for secure agentic systems, identify infrastructure gaps, and architect GitOps-driven solution with zero-trust by default.',
        icon: 'tabler:stethoscope',
      },
      {
        title: '<span class="font-medium">Build & Secure</span>',
        description:
          'Hands-on implementation from ArgoCD/Crossplane infrastructure code to Kyverno/Falco security policies. Direct execution, not just templates.',
        icon: 'tabler:tools',
      },
      {
        title: '<span class="font-medium">Deploy & Operate</span>',
        description:
          'Run autonomous agents in production with observable systems, policy enforcement, and runtime threat detection. Monitor, optimize, and iterate.',
        icon: 'tabler:rocket',
      },
      {
        title: '<span class="font-medium">Transfer & Empower</span>',
        description:
          'Document architecture, GitOps workflows, and security policies. Equip your team to evolve the system independently post-engagement.',
        icon: 'tabler:school',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1616198814651-e71f960c3180?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=987&q=80',
      alt: 'Kubernetes Platform',
    }}
  />

  <!-- Features2 Widget ************** -->

  <Features2
    title="Why Choose Kubekub"
    subtitle="25+ years architecting secure, scalable infrastructure applied to autonomous agent systems"
    tagline="Value Proposition"
    items={[
      {
        title: 'Security-First Architecture',
        description: 'Zero-trust by design: ambient mesh, runtime security (Falco), policy enforcement (Kyverno), and policy-based authorization built into every layer.',
        icon: 'tabler:shield-lock',
      },
      {
        title: 'Agentic Infrastructure Expertise',
        description: 'KAgent, MCP, ToolHive, and Gateway API for autonomous agent systems designed to scale across on-premises and multi-cloud.',
        icon: 'tabler:robot',
      },
      {
        title: 'GitOps Everything',
        description: 'Infrastructure as Code, policy as code, configuration as code—single source of truth with ArgoCD, Crossplane, and declarative automation.',
        icon: 'tabler:git-branch',
      },
      {
        title: 'Battle-Tested at Scale',
        description: 'Production experience running large-scale Kubernetes platforms with Istio, Prometheus, distributed tracing, and enterprise observability.',
        icon: 'tabler:award',
      },
      {
        title: 'Hands-On Execution',
        description: 'Not just strategy—direct implementation from manifests to CI/CD pipelines. Transfer knowledge to empower your team independently.',
        icon: 'tabler:tools',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Features2>

  <!-- CallToAction Widget *********** -->

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Get in Touch',
        href: '/contact',
        icon: 'tabler:message-circle',
      },
    ]}
  >
    <Fragment slot="title">
      Ready to Build Secure Agentic Infrastructure?
    </Fragment>

    <Fragment slot="subtitle">
      Planning autonomous agent systems? Let's discuss how Kubekub can architect secure, scalable, GitOps-driven infrastructure that delivers production-ready agentic AI platforms.
    </Fragment>
  </CallToAction>

</Layout>
