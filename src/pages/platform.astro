---
import Hero from '~/components/widgets/Hero.astro';
import Content from '~/components/widgets/Content.astro';
import Layout from '~/layouts/PageLayout.astro';
import PlatformArchitecture from '~/components/platform/PlatformArchitecture';
import { readFileSync } from 'fs';
import yaml from 'js-yaml';
import { fileURLToPath } from 'url';
import path from 'path';

const metadata = {
  title: 'Secure Agentic AI Platform: Reference Architecture',
  description: 'Production-ready Kubernetes platform architecture for secure Agentic AI workloads with zero trust security, agent authorization, and comprehensive observability.',
};

// Load platform technologies data
const __dirname = path.dirname(fileURLToPath(import.meta.url));
const yamlPath = path.join(__dirname, '../data/platform/platform-technologies.yaml');
const platformData = yaml.load(readFileSync(yamlPath, 'utf8'));
---

<Layout metadata={metadata}>

  <!-- Hero Widget ******************* -->

  <Hero
    tagline="Reference Architecture"
    title="Secure Agentic AI Platform"
    subtitle="Production-ready Kubernetes platform architecture for secure Agentic AI workloads. Built with GitOps, zero trust security, and comprehensive observability."
  >
  </Hero>

  <!-- Interactive Architecture Diagram ******************* -->
  
  <section class="px-4 py-16 sm:px-6 mx-auto lg:px-8 lg:py-20 max-w-7xl">
    <div class="mb-8 text-center">
      <h2 class="text-4xl md:text-5xl font-bold leading-tighter tracking-tighter mb-4 font-heading">
        Platform Architecture
      </h2>
      <p class="text-xl text-muted dark:text-slate-400">
        Multi-cloud Kubernetes platform with 70+ integrated technologies
      </p>
    </div>
    
    <PlatformArchitecture platformData={platformData} client:load />
  </section>

  <!-- Platform Architecture Overview ******************* -->

  <Content
    title="Architecture Layers"
    subtitle="Three-tier architecture for agentic AI at scale"
    isReversed
    items={[
      {
        title: 'KubeKub Agentic',
        description: 'Autonomous agent orchestration layer with KAgent, Agent Gateway, and Envoy AI Gateway for LLM traffic management and agent protocol handling.',
        icon: 'tabler:bolt',
      },
      {
        title: 'KubeKub Ops',
        description: 'GitOps layer with ArgoCD for continuous deployment and Crossplane for infrastructure provisioning. Networking & Security (Calico eBPF, Istio Ambient Mesh, Cert Manager, External DNS, External Secrets) and Observability Stack (Prometheus, Grafana Mimir, Loki, Tempo, OpenTelemetry).',
        icon: 'tabler:stack',
      },
      {
        title: 'Infrastructure & Core',
        description: 'Kubernetes unified API abstraction layer running on multi-cloud (AWS EKS, Azure AKS, GCP GKE, Tencent TKE) and bare metal (Kubespray, Minikube).',
        icon: 'tabler:server',
      },
      {
        title: 'Zero Trust Security',
        description: 'eBPF-based network policies, Ambient service mesh, mutual TLS, and strict identity verification for all AI agent operations.',
        icon: 'tabler:shield-lock',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

</Layout>

