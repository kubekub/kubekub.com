---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Kubekub — Gobernanza de IA Agéntica en Kubernetes',
  description:
    'Kubekub ayuda a las empresas a adoptar IA con más control, menos riesgo y preparación para la EU AI Act.',
  ignoreTitleTemplate: true,
};

const painCards = [
  {
    title: 'Las empresas quieren IA, pero no perder el control',
    description:
      'Cuando los agentes de IA actúan sobre sistemas internos, el problema pasa a ser control, aprobaciones y responsabilidad.',
    accent: 'from-rose-500 to-orange-400',
  },
  {
    title: 'La gobernanza suele llegar tarde',
    description:
      'Seguridad, legal y auditoria necesitan permisos claros, trazabilidad y supervision humana antes de escalar.',
    accent: 'from-amber-500 to-yellow-300',
  },
  {
    title: 'Los stacks cerrados generan dependencia',
    description:
      'Muchas empresas no quieren resolver la urgencia actual de IA cediendo el control de datos y arquitectura.',
    accent: 'from-sky-500 to-cyan-300',
  },
];

const outcomeCards = [
  {
    kicker: 'Resultado 1',
    title: 'Adoptar IA con limites claros',
    description:
      'Usa agentes con alcance definido, acceso controlado y aprobaciones para acciones sensibles.',
  },
  {
    kicker: 'Resultado 2',
    title: 'Gobernanza que ayuda a escalar',
    description:
      'Da a seguridad, auditoria y compliance la evidencia necesaria para avanzar sin puntos ciegos.',
  },
  {
    kicker: 'Resultado 3',
    title: 'Mantener propiedad y control',
    description:
      'Ejecuta el blueprint en tu entorno y conserva el control a largo plazo.',
  },
];

const stackLayers = [
  {
    title: 'Gateway de IA y guardrails',
    description: 'Autenticacion, filtrado de prompts, enforcement de politicas y entrada controlada de trafico.',
  },
  {
    title: 'Autorizacion e identidad',
    description: 'Integracion con IdP y autorizacion de grano fino para usuarios, agentes, herramientas y datos.',
  },
  {
    title: 'Runtime nativo en Kubernetes',
    description: 'Runtimes open source, aislamiento de workloads, limites de recursos y fronteras de red.',
  },
  {
    title: 'Gobernanza MCP y herramientas',
    description: 'Herramientas descubribles, versionadas y auditables en lugar de integraciones opacas.',
  },
  {
    title: 'GitOps y operaciones',
    description: 'Infraestructura y politicas gestionadas como codigo para operar y evolucionar con seguridad.',
  },
  {
    title: 'Opcionalidad open source',
    description: 'Estandares y componentes reemplazables para reducir lock-in y mantener soberania tecnica.',
  },
];

const audience = [
  'Equipos de plataforma que necesitan pasar de experimentos a produccion',
  'Empresas reguladas o sensibles al riesgo que necesitan gobernanza antes de escalar',
  'Organizaciones que quieren arquitectura open source en lugar de cajas negras',
];
---

<Layout metadata={metadata}>
  <section class="relative overflow-hidden bg-[linear-gradient(135deg,#fff7ed_0%,#f8fafc_38%,#ecfeff_100%)] dark:bg-[linear-gradient(135deg,#0f172a_0%,#111827_42%,#022c22_100%)]">
    <div class="absolute inset-0 opacity-70">
      <div class="absolute left-[-10rem] top-[-7rem] h-72 w-72 rounded-full bg-orange-200/60 blur-3xl dark:bg-orange-500/15"></div>
      <div class="absolute right-[-8rem] top-20 h-80 w-80 rounded-full bg-cyan-200/60 blur-3xl dark:bg-cyan-500/15"></div>
      <div class="absolute bottom-[-9rem] left-1/3 h-72 w-72 rounded-full bg-emerald-200/50 blur-3xl dark:bg-emerald-500/10"></div>
    </div>

    <div class="relative mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8 lg:py-28">
      <div class="grid gap-12 lg:grid-cols-[1.15fr_0.85fr] lg:items-start">
        <div>
          <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-slate-900/10 bg-white/80 px-4 py-2 text-sm font-medium tracking-wide text-slate-700 shadow-sm backdrop-blur dark:border-white/10 dark:bg-slate-900/60 dark:text-slate-200">
            <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
            Gobernanza y control de IA Agéntica
          </div>

          <h1 class="max-w-4xl font-heading text-5xl font-black leading-[0.96] tracking-[-0.04em] text-slate-950 dark:text-white sm:text-6xl xl:text-7xl">
            Control y responsabilidad para la IA Agéntica en tu empresa.
          </h1>

          <p class="mt-6 max-w-3xl text-xl leading-8 text-slate-700 dark:text-slate-300">
            La barrera no es solo el modelo. Es permitir que agentes de IA actuen sobre sistemas reales con permisos, aprobaciones y trazabilidad.
          </p>

          <p class="mt-4 max-w-3xl text-lg leading-8 text-slate-600 dark:text-slate-400">
            Kubekub aplica platform engineering para pasar de pruebas a despliegues controlados con gobernanza por diseno y preparacion para la EU AI Act.
          </p>

          <div class="mt-10 flex flex-col gap-4 sm:flex-row">
            <a
              href="/es/contact"
              class="inline-flex items-center justify-center rounded-full bg-slate-950 px-7 py-4 text-base font-semibold text-white shadow-[0_18px_45px_-18px_rgba(15,23,42,0.7)] transition hover:-translate-y-0.5 hover:bg-slate-800 dark:bg-white dark:text-slate-950 dark:hover:bg-slate-200"
            >
              Hablar con nosotros
            </a>
            <a
              href="/es/blueprint"
              class="inline-flex items-center justify-center rounded-full border border-slate-300 bg-white/80 px-7 py-4 text-base font-semibold text-slate-900 backdrop-blur transition hover:-translate-y-0.5 hover:border-slate-950 dark:border-white/15 dark:bg-slate-900/60 dark:text-white dark:hover:border-white/40"
            >
              Ver el Blueprint
            </a>
          </div>
        </div>

        <div class="lg:pt-6">
          <div class="rounded-[2rem] border border-slate-200/70 bg-white/80 p-6 shadow-[0_30px_120px_-40px_rgba(15,23,42,0.45)] backdrop-blur dark:border-white/10 dark:bg-slate-900/70">
            <div class="rounded-[1.5rem] bg-slate-950 p-6 text-white dark:bg-slate-950/90">
              <div class="text-xs font-semibold uppercase tracking-[0.22em] text-cyan-300">El reto actual</div>
              <div class="mt-4 text-3xl font-bold leading-tight">La IA escala mas rapido de lo que la empresa puede gobernarla.</div>
              <div class="mt-4 space-y-3 text-sm leading-6 text-slate-300">
                <div class="flex items-start gap-3">
                  <span class="mt-1 h-2.5 w-2.5 rounded-full bg-cyan-300"></span>
                  <p>Negocio ve valor, pero seguridad y compliance ven riesgo.</p>
                </div>
                <div class="flex items-start gap-3">
                  <span class="mt-1 h-2.5 w-2.5 rounded-full bg-emerald-300"></span>
                  <p>Sin gobernanza, la responsabilidad legal y operativa se queda en la empresa.</p>
                </div>
                <div class="flex items-start gap-3">
                  <span class="mt-1 h-2.5 w-2.5 rounded-full bg-amber-300"></span>
                  <p>Resultado: puntos ciegos, shadow AI y dependencia de proveedores cerrados.</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-slate-950 py-20 text-white dark:bg-black">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <p class="text-sm font-semibold uppercase tracking-[0.24em] text-orange-300">Dolores que vemos</p>
        <h2 class="mt-4 font-heading text-4xl font-black tracking-[-0.03em] sm:text-5xl">
          El problema no es la ambicion de IA. Es la falta de control.
        </h2>
      </div>

      <div class="mt-12 grid gap-6 lg:grid-cols-3">
        {painCards.map((card) => (
          <article class="group overflow-hidden rounded-[1.75rem] border border-white/10 bg-white/5">
            <div class={`h-2 w-full bg-gradient-to-r ${card.accent}`}></div>
            <div class="p-7">
              <h3 class="text-2xl font-semibold leading-tight text-white">{card.title}</h3>
              <p class="mt-4 text-base leading-7 text-slate-300">{card.description}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-white py-20 dark:bg-slate-950">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.24em] text-orange-600 dark:text-orange-300">Resultados</p>
          <h2 class="mt-4 font-heading text-4xl font-black tracking-[-0.03em] text-slate-950 dark:text-white sm:text-5xl">
            Adopcion de IA Agéntica con responsabilidad clara.
          </h2>
          <p class="mt-6 text-lg leading-8 text-slate-600 dark:text-slate-400">
            Kubekub ofrece un camino controlado para que negocio, seguridad y compliance puedan avanzar juntos.
          </p>
          <p class="mt-4 text-lg leading-8 text-slate-600 dark:text-slate-400">
            Objetivo: mas control, mas confianza y menos lock-in.
          </p>
        </div>

        <div class="grid gap-5 md:grid-cols-3">
          {outcomeCards.map((item) => (
            <article class="rounded-[1.75rem] border border-slate-200 bg-slate-50 p-6 shadow-[0_18px_50px_-40px_rgba(15,23,42,0.8)] dark:border-white/10 dark:bg-slate-900/60">
              <div class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500 dark:text-slate-400">{item.kicker}</div>
              <h3 class="mt-3 text-xl font-semibold leading-tight text-slate-950 dark:text-white">{item.title}</h3>
              <p class="mt-3 text-sm leading-7 text-slate-600 dark:text-slate-400">{item.description}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="bg-[linear-gradient(180deg,#fffaf0_0%,#ffffff_100%)] py-20 dark:bg-[linear-gradient(180deg,#111827_0%,#0f172a_100%)]">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mb-10 max-w-3xl">
        <p class="text-sm font-semibold uppercase tracking-[0.24em] text-cyan-700 dark:text-cyan-300">Como lo hacemos posible</p>
        <h2 class="mt-4 font-heading text-4xl font-black tracking-[-0.03em] text-slate-950 dark:text-white sm:text-5xl">
          El metodo es tecnico. El objetivo es control de negocio.
        </h2>
        <p class="mt-5 text-lg leading-8 text-slate-600 dark:text-slate-400">
          Usamos platform engineering y componentes open source para mantener control sobre datos, operaciones y evolucion futura.
        </p>
      </div>

      <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
        {stackLayers.map((layer, index) => (
          <article class="rounded-[1.5rem] border border-slate-200 bg-white p-6 dark:border-white/10 dark:bg-slate-900/60">
            <div class="flex items-center gap-3">
              <div class="flex h-10 w-10 items-center justify-center rounded-full bg-slate-950 text-sm font-bold text-white dark:bg-white dark:text-slate-950">
                {index + 1}
              </div>
              <h3 class="text-xl font-semibold text-slate-950 dark:text-white">{layer.title}</h3>
            </div>
            <p class="mt-4 text-sm leading-7 text-slate-600 dark:text-slate-400">{layer.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-slate-100 py-20 dark:bg-slate-900">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-8 lg:grid-cols-[0.95fr_1.05fr]">
        <div class="rounded-[2rem] bg-slate-950 p-8 text-white dark:bg-black">
          <p class="text-sm font-semibold uppercase tracking-[0.24em] text-emerald-300">Para quien es</p>
          <h2 class="mt-4 font-heading text-4xl font-black tracking-[-0.03em] sm:text-5xl">
            Empresas que necesitan un camino seguro de la experimentacion a la adopcion.
          </h2>
          <div class="mt-8 space-y-4">
            {audience.map((item) => (
              <div class="flex gap-4 rounded-2xl border border-white/10 bg-white/5 p-4">
                <span class="mt-1 h-2.5 w-2.5 flex-none rounded-full bg-emerald-300"></span>
                <p class="text-base leading-7 text-slate-200">{item}</p>
              </div>
            ))}
          </div>
        </div>

        <div class="rounded-[2rem] border border-slate-200 bg-white p-8 dark:border-white/10 dark:bg-slate-950/70">
          <p class="text-sm font-semibold uppercase tracking-[0.24em] text-slate-500 dark:text-slate-400">Modelo de trabajo</p>
          <h3 class="mt-4 text-3xl font-bold tracking-[-0.03em] text-slate-950 dark:text-white">
            Un blueprint que tu empresa puede operar.
          </h3>
          <p class="mt-5 text-lg leading-8 text-slate-600 dark:text-slate-400">
            Kubekub se enfoca en arquitectura, integracion, gobernanza y despliegue. El resultado es una base de adopcion de IA con mas control y menos lock-in.
          </p>
          <div class="mt-8 rounded-[1.5rem] bg-orange-50 p-6 dark:bg-orange-500/10">
            <div class="text-sm font-semibold uppercase tracking-[0.22em] text-orange-700 dark:text-orange-300">Resultado</div>
            <p class="mt-3 text-lg leading-8 text-slate-700 dark:text-slate-300">
              Agentes de IA operando dentro de la empresa con limites claros, supervision humana y evidencia para seguridad y compliance.
            </p>
          </div>
          <div class="mt-8 flex flex-col gap-4 sm:flex-row">
            <a
              href="/es/technical"
              class="inline-flex items-center justify-center rounded-full border border-slate-300 px-6 py-3.5 text-sm font-semibold text-slate-900 transition hover:border-slate-950 dark:border-white/15 dark:text-white dark:hover:border-white/40"
            >
              Ver detalles tecnicos
            </a>
            <a
              href="/es/contact"
              class="inline-flex items-center justify-center rounded-full bg-orange-500 px-6 py-3.5 text-sm font-semibold text-white transition hover:bg-orange-600"
            >
              Hablar sobre un despliegue
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
