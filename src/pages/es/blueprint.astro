---
import Hero from '~/components/widgets/Hero.astro';
import Layout from '~/layouts/PageLayout.astro';
import PlatformArchitecture from '~/components/blueprint/PlatformArchitecture';

const metadata = {
  title: 'Blueprint: Arquitectura de referencia',
  description: 'Arquitectura de referencia en Kubernetes para IA Agéntica segura y gobernable.',
};
---

<Layout metadata={metadata}>
  <Hero
    tagline="Blueprint Tecnologico"
    title="Arquitectura de referencia para IA Agéntica"
    subtitle="No es un SaaS. Es un blueprint probado para desplegar agentes con control en la infraestructura del cliente."
  />

  <section class="px-4 py-16 sm:px-6 mx-auto lg:px-8 lg:py-20 max-w-7xl">
    <div class="mb-8 text-center">
      <h2 class="text-4xl md:text-5xl font-bold leading-tighter tracking-tighter mb-4 font-heading">
        Platform Blueprint
      </h2>
      <p class="text-xl text-muted dark:text-slate-400">
        Arquitectura Kubernetes multi-cloud con tecnologias seleccionadas para gobernanza y seguridad
      </p>
    </div>

    <PlatformArchitecture client:load />
  </section>

  <section class="px-4 py-16 sm:px-6 mx-auto lg:px-8 lg:py-20 max-w-7xl">
    <div class="mb-12">
      <h2 class="text-4xl md:text-5xl font-bold leading-tighter tracking-tighter mb-4 font-heading">
        Capas de arquitectura
      </h2>
      <p class="text-xl text-muted dark:text-slate-400 mb-8">
        Cuatro capas para operar IA Agéntica en entornos empresariales
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="border-l-4 border-rose-400 bg-slate-50 dark:bg-slate-900/30 rounded-lg p-6 hover:shadow-lg transition">
          <div class="flex items-center gap-3 mb-3">
            <div class="w-3 h-3 rounded-full bg-rose-400"></div>
            <h3 class="font-bold text-lg text-slate-900 dark:text-slate-200">Kubekub Agentic</h3>
          </div>
          <p class="text-sm text-slate-700 dark:text-slate-400">
            Orquestacion de agentes y gestion de trafico de inferencia.
          </p>
        </div>

        <div class="border-l-4 border-amber-400 bg-slate-50 dark:bg-slate-900/30 rounded-lg p-6 hover:shadow-lg transition">
          <div class="flex items-center gap-3 mb-3">
            <div class="w-3 h-3 rounded-full bg-amber-400"></div>
            <h3 class="font-bold text-lg text-slate-900 dark:text-slate-200">Kubekub Identity</h3>
          </div>
          <p class="text-sm text-slate-700 dark:text-slate-400">
            Autenticacion y autorizacion de grano fino con identidad centralizada.
          </p>
        </div>

        <div class="border-l-4 border-emerald-400 bg-slate-50 dark:bg-slate-900/30 rounded-lg p-6 hover:shadow-lg transition">
          <div class="flex items-center gap-3 mb-3">
            <div class="w-3 h-3 rounded-full bg-emerald-400"></div>
            <h3 class="font-bold text-lg text-slate-900 dark:text-slate-200">Kubekub Ops</h3>
          </div>
          <p class="text-sm text-slate-700 dark:text-slate-400">
            GitOps, red, seguridad, observabilidad y recuperacion.
          </p>
        </div>

        <div class="border-l-4 border-blue-400 bg-slate-50 dark:bg-slate-900/30 rounded-lg p-6 hover:shadow-lg transition">
          <div class="flex items-center gap-3 mb-3">
            <div class="w-3 h-3 rounded-full bg-blue-400"></div>
            <h3 class="font-bold text-lg text-slate-900 dark:text-slate-200">Infraestructura & Core</h3>
          </div>
          <p class="text-sm text-slate-700 dark:text-slate-400">
            Kubernetes como capa unificada entre cualquier cloud y on-prem.
          </p>
        </div>
      </div>
    </div>
  </section>
</Layout>
