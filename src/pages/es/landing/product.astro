---
import Layout from '~/layouts/LandingLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Demo Landing Producto',
};
---

<Layout metadata={metadata}>
  <Hero
    tagline="Demo Producto"
    title="Landing de producto: comunica valor con precision"
    subtitle="Guia paso a paso para destacar tu producto o servicio y mejorar conversion."
    actions={[
      { variant: 'primary', text: 'Llamada a la accion', href: '#', icon: 'tabler:square-rounded-arrow-right' },
      { text: 'Saber mas', href: '#' },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1473188588951-666fce8e7c68?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2174&q=80',
      alt: 'Landing de producto',
    }}
  />

  <CallToAction
    title="Proximamente"
    subtitle="Estamos trabajando en el contenido de estas paginas demo. Muy pronto estaran listas."
    actions={[
      {
        variant: 'primary',
        text: 'Descargar plantilla',
        href: 'https://github.com/arthelokyo/Kubekub',
        icon: 'tabler:download',
      },
    ]}
  />
</Layout>
