---
import Layout from '~/layouts/LandingLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Demo Landing Generacion de Leads',
};
---

<Layout metadata={metadata}>
  <Hero
    tagline="Demo Lead Generation"
    title="Landing para generar leads de forma efectiva"
    subtitle="Convierte visitas curiosas en oportunidades reales con una propuesta clara."
    actions={[
      { variant: 'primary', text: 'Llamada a la accion', href: '#', icon: 'tabler:square-rounded-arrow-right' },
      { text: 'Saber mas', href: '#' },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1597423498219-04418210827d?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1674&q=80',
      alt: 'Landing de generacion de leads',
    }}
  />

  <CallToAction
    title="Proximamente"
    subtitle="Estamos trabajando en el contenido de estas paginas demo. Muy pronto estaran listas."
    actions={[
      {
        variant: 'primary',
        text: 'Descargar plantilla',
        href: 'https://github.com/arthelokyo/Kubekub',
        icon: 'tabler:download',
      },
    ]}
  />
</Layout>
